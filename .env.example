# Variables de entorno para el despliegue con docker-compose.
#
# Copia este fichero a `.env` (junto a docker-compose.yml) y rellena los valores.
# `.env` está en .gitignore y NUNCA debe subirse al repositorio.
#
# Lo consume el servicio `archivo-oasis-api` de docker-compose.yml.

# URL base de tu Jellyfin, sin barra final.
JELLYFIN_URL=https://teatro.archivo-oasis.com

# Usuario de Jellyfin que actúa como administrador en archivo-oasis.
# La comparación es case-insensitive. No es una columna en la BD: se
# calcula en cada petición contra esta variable.
ADMIN_JELLYFIN_USERNAME=

# Clave para firmar la cookie de sesión. Genuinamente secreta.
# Genérala con:  openssl rand -hex 32
SESSION_SECRET=

# API key de administrador de Jellyfin.
# Jellyfin → Panel → Administración → Avanzado → Claves API → botón "+"
# Necesaria para la herramienta de invitaciones (crear usuarios de Jellyfin).
# Si se deja vacía, el backend arranca igual pero /api/invites responde 503.
JELLYFIN_API_KEY=

# qBittorrent (sección Aportaciones). URL de la WebUI, sin barra final, y las
# credenciales de acceso. qBittorrent no usa API keys: es usuario/contraseña.
# Si se dejan vacías, el backend arranca igual pero aceptar una aportación
# responde 503.
QBITTORRENT_URL=https://qbittorrent.archivo-oasis.com
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

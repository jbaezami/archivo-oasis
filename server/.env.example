# Copia este fichero a `server/.env` y rellena los valores.
# `server/.env` está en .gitignore y NUNCA debe subirse al repositorio.

# URL base de Jellyfin (sin barra final)
JELLYFIN_URL=https://teatro.archivo-oasis.com

# Usuario de Jellyfin que actúa como administrador en archivo-oasis (case-insensitive)
ADMIN_JELLYFIN_USERNAME=

# Clave para firmar la cookie de sesión. En local cualquier cadena larga vale.
# En producción: genuinamente secreta, p.ej. `openssl rand -hex 32`
SESSION_SECRET=

# API key de administrador de Jellyfin.
# Jellyfin → Panel → Administración → Avanzado → Claves API → botón "+"
# Necesaria para la herramienta de invitaciones (crear usuarios de Jellyfin).
# Si se deja vacía, el backend arranca igual pero /api/invites responde 503.
JELLYFIN_API_KEY=

# qBittorrent (sección Aportaciones). WebUI sin barra final + usuario/contraseña.
# Si se dejan vacías, aceptar una aportación responde 503.
QBITTORRENT_URL=https://qbittorrent.archivo-oasis.com
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
